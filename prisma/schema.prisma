// ============================================
// SHOPIFY INTEGRATION MODELS
// ============================================

model ShopifyStore {
  id           String  @id @default(uuid())
  shopDomain   String  @unique // e.g., "store-name.myshopify.com"
  shopName     String
  shopEmail    String
  shopCurrency String  @default("USD")
  shopCountry  String?

  // Linked seller account on 0xMart
  sellerId String? @unique
  seller   Seller? @relation(fields: [sellerId], references: [id])

  // API credentials for the Shopify app to call our backend
  apiKey    String @unique @default(uuid())
  apiSecret String @default(uuid())

  // Sync settings
  isConnected     Boolean   @default(false)
  connectedAt     DateTime?
  syncAllProducts Boolean   @default(false)
  autoSyncEnabled Boolean   @default(true)
  commissionRate  Decimal   @default(0.20) @db.Decimal(5, 4) // 20% commission

  // Timestamps
  lastProductSync DateTime?
  lastOrderSync   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  products ShopifyProduct[]
  orders   ShopifyOrder[]

  @@index([shopDomain])
  @@index([sellerId])
  @@index([apiKey])
  @@map("shopify_stores")
}

model ShopifyProduct {
  id             String       @id @default(uuid())
  shopifyStoreId String
  store          ShopifyStore @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)

  // Shopify product info
  shopifyProductId String // Shopify GID (e.g., "gid://shopify/Product/123")
  shopifyVariantId String? // Main variant ID
  shopifyHandle    String
  title            String
  description      String?
  originalPrice    Decimal @db.Decimal(20, 8)
  originalCurrency String
  imageUrl         String?

  // 0xMart product info
  oxmartProductId String?  @unique // Linked 0xMart Product ID
  oxmartProduct   Product? @relation(fields: [oxmartProductId], references: [id])
  priceUsdt       Decimal? @db.Decimal(20, 8) // Price with commission in USDT

  // Sync status
  isSelected   Boolean   @default(false)
  isSynced     Boolean   @default(false)
  lastSyncedAt DateTime?
  syncError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopifyStoreId, shopifyProductId])
  @@index([shopifyProductId])
  @@index([oxmartProductId])
  @@map("shopify_products")
}

model ShopifyOrder {
  id             String       @id @default(uuid())
  shopifyStoreId String
  store          ShopifyStore @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)

  // 0xMart order info
  oxmartOrderId       String  @unique
  oxmartOrder         Order   @relation(fields: [oxmartOrderId], references: [id])
  oxmartOrderStatus   String
  oxmartPaymentStatus String?
  totalUsdt           Decimal @db.Decimal(20, 8)

  // Shopify order info (created when synced back)
  shopifyOrderId       String? // Shopify GID after creation
  shopifyOrderName     String? // Order #1001 etc.
  shopifyFulfillmentId String?

  // Customer info
  customerEmail   String?
  customerName    String?
  shippingAddress Json?

  // Sync status
  isSyncedToShopify Boolean   @default(false)
  syncedAt          DateTime?
  syncError         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopifyStoreId])
  @@index([oxmartOrderId])
  @@index([shopifyOrderId])
  @@map("shopify_orders")
}

