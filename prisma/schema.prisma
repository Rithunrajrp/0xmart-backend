// Hierarchical Product Categories
model ProductCategory {
  id          String  @id @default(uuid())
  sellerId    String? // null for global categories
  name        String
  slug        String  @unique
  description String?
  handle      String  @unique
  imageUrl    String?
  isActive    Boolean @default(true)
  isInternal  Boolean @default(false) // Hidden from storefront
  rank        Int     @default(0) // For ordering
  metadata    Json?

  // Hierarchical structure
  parentId String?
  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")

  // Relations
  products ProductCategoryProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([parentId])
  @@index([slug])
  @@index([handle])
  @@index([isActive])
  @@map("product_categories")
}

// Many-to-many relation for products and categories
model ProductCategoryProduct {
  id         String          @id @default(uuid())
  productId  String
  categoryId String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_category_products")
}

// Product Collections (curated groupings)
model ProductCollection {
  id          String  @id @default(uuid())
  sellerId    String?
  title       String
  handle      String  @unique
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)
  metadata    Json?

  // Relations
  products ProductCollectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([handle])
  @@index([isActive])
  @@map("product_collections")
}

model ProductCollectionProduct {
  id           String            @id @default(uuid())
  productId    String
  collectionId String
  position     Int               @default(0)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@unique([productId, collectionId])
  @@index([productId])
  @@index([collectionId])
  @@map("product_collection_products")
}

// Product Tags
model ProductTag {
  id        String              @id @default(uuid())
  sellerId  String?
  value     String
  metadata  Json?
  products  ProductTagProduct[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([sellerId, value])
  @@index([sellerId])
  @@index([value])
  @@map("product_tags")
}

model ProductTagProduct {
  id        String     @id @default(uuid())
  productId String
  tagId     String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([productId, tagId])
  @@index([productId])
  @@index([tagId])
  @@map("product_tag_products")
}

// Product Type (defines attributes for a category of products)
model ProductType {
  id        String    @id @default(uuid())
  sellerId  String?
  value     String
  metadata  Json?
  products  Product[] @relation("ProductTypeRelation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([sellerId, value])
  @@index([sellerId])
  @@map("product_types")
}

// Promotions (Discounts)
model Promotion {
  id       String          @id @default(uuid())
  sellerId String?
  code     String?         @unique
  type     PromotionType
  status   PromotionStatus @default(DRAFT)

  // Discount configuration
  isAutomatic Boolean  @default(false)
  ruleType    String // percentage, fixed_amount, buy_x_get_y
  ruleValue   Decimal? @db.Decimal(20, 8)

  // Limits
  usageLimit       Int?
  usageCount       Int  @default(0)
  perCustomerLimit Int?

  // Validity
  startsAt DateTime?
  endsAt   DateTime?

  // Targeting
  targetType String? // all, specific_products, specific_categories
  targetIds  String[] @default([])

  // Conditions
  minPurchaseAmount Decimal? @db.Decimal(20, 8)
  minQuantity       Int?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  campaignId String?
  campaign   Campaign?        @relation(fields: [campaignId], references: [id])
  usages     PromotionUsage[]

  @@index([sellerId])
  @@index([code])
  @@index([status])
  @@index([type])
  @@index([startsAt, endsAt])
  @@index([campaignId])
  @@map("promotions")
}

model PromotionUsage {
  id          String    @id @default(uuid())
  promotionId String
  orderId     String?
  customerId  String?
  amount      Decimal   @db.Decimal(20, 8)
  usedAt      DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([customerId])
  @@index([orderId])
  @@map("promotion_usages")
}

// Marketing Campaigns
model Campaign {
  id          String         @id @default(uuid())
  sellerId    String?
  name        String
  description String?
  status      CampaignStatus @default(DRAFT)

  // Budget
  budgetType   String? // total, daily
  budgetAmount Decimal? @db.Decimal(20, 8)
  spentAmount  Decimal  @default(0) @db.Decimal(20, 8)

  // Validity
  startsAt DateTime?
  endsAt   DateTime?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  promotions Promotion[]

  @@index([sellerId])
  @@index([status])
  @@index([startsAt, endsAt])
  @@map("campaigns")
}

// Price Lists (for wholesale, VIP, or sale pricing)
model PriceList {
  id          String          @id @default(uuid())
  sellerId    String?
  name        String
  description String?
  type        PriceListType   @default(SALE)
  status      PriceListStatus @default(DRAFT)

  // Validity
  startsAt DateTime?
  endsAt   DateTime?

  // Customer targeting
  customerGroupIds String[] @default([])

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  prices PriceListPrice[]

  @@index([sellerId])
  @@index([status])
  @@index([type])
  @@index([startsAt, endsAt])
  @@map("price_lists")
}

model PriceListPrice {
  id             String         @id @default(uuid())
  priceListId    String
  productId      String?
  variantId      String?
  stablecoinType StablecoinType
  price          Decimal        @db.Decimal(20, 8)
  minQuantity    Int            @default(1)
  maxQuantity    Int?
  priceList      PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([priceListId, productId, variantId, stablecoinType, minQuantity])
  @@index([priceListId])
  @@index([productId])
  @@index([variantId])
  @@map("price_list_prices")
}

// Customer Groups (for segmentation)
model CustomerGroup {
  id          String                    @id @default(uuid())
  sellerId    String?
  name        String
  description String?
  metadata    Json?
  customers   CustomerGroupMembership[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([sellerId])
  @@map("customer_groups")
}

model CustomerGroupMembership {
  id              String        @id @default(uuid())
  customerGroupId String
  userId          String
  customerGroup   CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([customerGroupId, userId])
  @@index([customerGroupId])
  @@index([userId])
  @@map("customer_group_memberships")
}

// Stock Locations (for multi-location inventory)
model StockLocation {
  id           String  @id @default(uuid())
  sellerId     String
  name         String
  code         String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  phone        String?
  isActive     Boolean @default(true)
  metadata     Json?

  // Relations
  inventoryLevels InventoryLevel[]
  fulfillments    Fulfillment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, code])
  @@index([sellerId])
  @@index([isActive])
  @@map("stock_locations")
}

// Inventory Levels (stock per variant per location)
model InventoryLevel {
  id               String @id @default(uuid())
  variantId        String
  locationId       String
  stockedQuantity  Int    @default(0)
  reservedQuantity Int    @default(0)
  incomingQuantity Int    @default(0)

  // Calculated: stockedQuantity - reservedQuantity
  availableQuantity Int @default(0)

  location     StockLocation         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  adjustments  InventoryAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, locationId])
  @@index([variantId])
  @@index([locationId])
  @@index([availableQuantity])
  @@map("inventory_levels")
}

// Inventory Adjustments (audit trail)
model InventoryAdjustment {
  id               String         @id @default(uuid())
  inventoryLevelId String
  quantity         Int // Can be negative for decrements
  reason           String?
  referenceType    String? // order, return, manual, etc.
  referenceId      String?
  adjustedBy       String?
  inventoryLevel   InventoryLevel @relation(fields: [inventoryLevelId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@index([inventoryLevelId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("inventory_adjustments")
}

// Reservations (hold stock for pending orders)
model Reservation {
  id               String         @id @default(uuid())
  inventoryLevelId String
  quantity         Int
  orderId          String?
  lineItemId       String?
  expiresAt        DateTime?
  inventoryLevel   InventoryLevel @relation(fields: [inventoryLevelId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@index([inventoryLevelId])
  @@index([orderId])
  @@index([expiresAt])
  @@map("reservations")
}

// Fulfillments (shipping from locations)
model Fulfillment {
  id             String            @id @default(uuid())
  orderId        String
  locationId     String?
  status         FulfillmentStatus @default(NOT_FULFILLED)
  trackingNumber String?
  trackingUrl    String?
  carrier        String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  metadata       Json?
  location       StockLocation?    @relation(fields: [locationId], references: [id])
  items          FulfillmentItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([orderId])
  @@index([locationId])
  @@index([status])
  @@map("fulfillments")
}

model FulfillmentItem {
  id            String      @id @default(uuid())
  fulfillmentId String
  orderItemId   String
  quantity      Int
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([fulfillmentId])
  @@index([orderItemId])
  @@map("fulfillment_items")
}

// Returns
model Return {
  id           String       @id @default(uuid())
  orderId      String
  status       ReturnStatus @default(REQUESTED)
  reason       String?
  note         String?
  refundAmount Decimal?     @db.Decimal(20, 8)
  requestedAt  DateTime     @default(now())
  receivedAt   DateTime?
  processedAt  DateTime?
  processedBy  String?
  metadata     Json?
  items        ReturnItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("returns")
}

model ReturnItem {
  id          String   @id @default(uuid())
  returnId    String
  orderItemId String
  quantity    Int
  reason      String?
  note        String?
  return      Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([returnId])
  @@index([orderItemId])
  @@map("return_items")
}

// Refunds
model Refund {
  id             String         @id @default(uuid())
  orderId        String
  returnId       String?
  amount         Decimal        @db.Decimal(20, 8)
  stablecoinType StablecoinType
  network        NetworkType?
  txHash         String?        @unique
  status         RefundStatus   @default(PENDING)
  reason         String?
  note           String?
  processedAt    DateTime?
  processedBy    String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
  @@index([returnId])
  @@index([status])
  @@map("refunds")
}

// Exchanges
model Exchange {
  id               String         @id @default(uuid())
  orderId          String
  returnId         String?
  status           ExchangeStatus @default(REQUESTED)
  differenceAmount Decimal?       @db.Decimal(20, 8) // Positive if customer owes, negative if refund
  note             String?
  processedAt      DateTime?
  processedBy      String?
  metadata         Json?
  items            ExchangeItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([orderId])
  @@index([returnId])
  @@index([status])
  @@map("exchanges")
}

model ExchangeItem {
  id           String   @id @default(uuid())
  exchangeId   String
  orderItemId  String // Original item being exchanged
  newVariantId String // New variant to receive
  quantity     Int
  exchange     Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([exchangeId])
  @@index([orderItemId])
  @@map("exchange_items")
}

// Claims (for damaged/missing items)
model Claim {
  id           String      @id @default(uuid())
  orderId      String
  type         ClaimType
  status       ClaimStatus @default(OPEN)
  reason       String?
  description  String?
  images       Json? // Evidence images
  refundAmount Decimal?    @db.Decimal(20, 8)
  resolvedAt   DateTime?
  resolvedBy   String?
  resolution   String?
  metadata     Json?
  items        ClaimItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([orderId])
  @@index([type])
  @@index([status])
  @@map("claims")
}

model ClaimItem {
  id          String   @id @default(uuid())
  claimId     String
  orderItemId String
  quantity    Int
  reason      String?
  images      Json?
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([claimId])
  @@index([orderItemId])
  @@map("claim_items")
}

// Order Timeline Events
model OrderTimelineEvent {
  id          String   @id @default(uuid())
  orderId     String
  type        String // status_change, note_added, fulfillment_created, etc.
  title       String
  description String?
  userId      String? // Who performed the action
  isInternal  Boolean  @default(false) // Hidden from customer
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([type])
  @@index([createdAt])
  @@map("order_timeline_events")
}

// Internal Notes (for orders, products, customers)
model InternalNote {
  id         String   @id @default(uuid())
  entityType String // order, product, customer, etc.
  entityId   String
  content    String   @db.Text
  authorId   String
  authorName String?
  isPinned   Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([authorId])
  @@map("internal_notes")
}

// Sales Channels
model SalesChannel {
  id          String                @id @default(uuid())
  sellerId    String?
  name        String
  description String?
  isActive    Boolean               @default(true)
  isDefault   Boolean               @default(false)
  metadata    Json?
  products    SalesChannelProduct[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([sellerId])
  @@index([isActive])
  @@map("sales_channels")
}

model SalesChannelProduct {
  id             String       @id @default(uuid())
  salesChannelId String
  productId      String
  salesChannel   SalesChannel @relation(fields: [salesChannelId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([salesChannelId, productId])
  @@index([salesChannelId])
  @@index([productId])
  @@map("sales_channel_products")
}

// Enums for new models
enum PromotionType {
  STANDARD // Regular discount
  BUYGET // Buy X Get Y
  FREE_SHIPPING
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  ARCHIVED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum PriceListType {
  SALE
  OVERRIDE
  WHOLESALE
}

enum PriceListStatus {
  DRAFT
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum FulfillmentStatus {
  NOT_FULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  PARTIALLY_SHIPPED
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  RECEIVED
  PARTIALLY_RECEIVED
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExchangeStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum ClaimType {
  REFUND
  REPLACE
}

enum ClaimStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESOLVED
  CANCELLED
}

// ============================================
// ACCOUNTING & SETTLEMENT MODELS
// ============================================

// Merchant External Wallet - Where merchants receive settlements
model MerchantWallet {
  id             String         @id @default(uuid())
  sellerId       String
  seller         Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  network        NetworkType
  stablecoinType StablecoinType
  walletAddress  String
  label          String?        // e.g., "Primary USDT Wallet"
  isVerified     Boolean        @default(false)
  isDefault      Boolean        @default(false)
  verifiedAt     DateTime?
  verifiedBy     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([sellerId, network, stablecoinType])
  @@index([sellerId])
  @@index([walletAddress])
  @@map("merchant_wallets")
}

// Merchant Balance - Running balance owed to each merchant
model MerchantBalance {
  id                String         @id @default(uuid())
  sellerId          String
  seller            Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  stablecoinType    StablecoinType

  // Balances (all in the same stablecoin)
  pendingBalance    Decimal        @default(0) @db.Decimal(20, 8) // From recent orders, not yet available
  availableBalance  Decimal        @default(0) @db.Decimal(20, 8) // Ready for settlement
  totalEarned       Decimal        @default(0) @db.Decimal(20, 8) // Lifetime gross earnings
  totalSettled      Decimal        @default(0) @db.Decimal(20, 8) // Lifetime settlements paid
  totalCommission   Decimal        @default(0) @db.Decimal(20, 8) // Lifetime platform commission deducted
  totalRefunded     Decimal        @default(0) @db.Decimal(20, 8) // Lifetime refunds

  // Settlement preferences
  autoSettleEnabled Boolean        @default(false)
  autoSettleThreshold Decimal?     @db.Decimal(20, 8) // Auto-settle when available >= threshold

  lastCalculatedAt  DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([sellerId, stablecoinType])
  @@index([sellerId])
  @@index([availableBalance])
  @@map("merchant_balances")
}

// Ledger Account - Chart of Accounts for double-entry bookkeeping
model LedgerAccount {
  id              String            @id @default(uuid())
  code            String            @unique // e.g., "1001", "2001", "4001"
  name            String            // e.g., "Company USDT Wallet - Polygon"
  type            LedgerAccountType
  category        String?           // Sub-category for reporting
  description     String?
  isActive        Boolean           @default(true)
  isSystemAccount Boolean           @default(false) // Cannot be deleted

  // For sub-accounts
  parentId        String?
  parent          LedgerAccount?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        LedgerAccount[]   @relation("AccountHierarchy")

  // For tracking specific entity balances
  entityType      String?           // 'SELLER', 'NETWORK', 'STABLECOIN'
  entityId        String?           // sellerId, network name, etc.
  stablecoinType  StablecoinType?
  network         NetworkType?

  // Running balance (updated with each entry)
  balance         Decimal           @default(0) @db.Decimal(20, 8)

  entries         LedgerEntry[]
  journalLines    JournalEntryLine[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([code])
  @@index([type])
  @@index([entityType, entityId])
  @@index([isActive])
  @@map("ledger_accounts")
}

// Journal Entry - The main double-entry record
model JournalEntry {
  id              String              @id @default(uuid())
  entryNumber     String              @unique // Sequential: JE-2024-000001
  date            DateTime            @default(now())
  description     String

  // Reference to source transaction
  referenceType   String?             // 'ORDER', 'SETTLEMENT', 'REFUND', 'DEPOSIT', 'WITHDRAWAL'
  referenceId     String?

  // Entry details
  stablecoinType  StablecoinType
  totalAmount     Decimal             @db.Decimal(20, 8) // Total of debits (should equal credits)

  // Status
  status          JournalEntryStatus  @default(DRAFT)
  postedAt        DateTime?
  postedBy        String?
  reversedAt      DateTime?
  reversedBy      String?
  reversalEntryId String?             // If this entry was reversed, link to reversal

  // Audit
  createdBy       String?
  approvedBy      String?
  approvedAt      DateTime?

  lines           JournalEntryLine[]

  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([entryNumber])
  @@index([date])
  @@index([referenceType, referenceId])
  @@index([status])
  @@index([stablecoinType])
  @@map("journal_entries")
}

// Journal Entry Line - Individual debit/credit lines
model JournalEntryLine {
  id              String         @id @default(uuid())
  journalEntryId  String
  journalEntry    JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId       String
  account         LedgerAccount  @relation(fields: [accountId], references: [id])

  // Either debit or credit should be non-zero, not both
  debitAmount     Decimal        @default(0) @db.Decimal(20, 8)
  creditAmount    Decimal        @default(0) @db.Decimal(20, 8)

  description     String?

  createdAt       DateTime       @default(now())

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

// Legacy LedgerEntry - Simple ledger for quick queries (denormalized)
model LedgerEntry {
  id              String            @id @default(uuid())
  accountId       String
  account         LedgerAccount     @relation(fields: [accountId], references: [id])

  journalEntryId  String?           // Link to full journal entry

  date            DateTime          @default(now())
  description     String

  // Reference
  referenceType   String?
  referenceId     String?

  // Entry type
  entryType       LedgerEntryType
  stablecoinType  StablecoinType

  // Amounts
  debit           Decimal           @default(0) @db.Decimal(20, 8)
  credit          Decimal           @default(0) @db.Decimal(20, 8)
  balance         Decimal           @default(0) @db.Decimal(20, 8) // Running balance after this entry

  // Audit
  createdBy       String?

  metadata        Json?
  createdAt       DateTime          @default(now())

  @@index([accountId])
  @@index([date])
  @@index([referenceType, referenceId])
  @@index([entryType])
  @@index([stablecoinType])
  @@map("ledger_entries")
}

// Settlement - Payments made to merchants
model Settlement {
  id                String           @id @default(uuid())
  settlementNumber  String           @unique // SET-2024-000001
  sellerId          String
  seller            Seller           @relation(fields: [sellerId], references: [id])

  // Amount details
  stablecoinType    StablecoinType
  network           NetworkType
  grossAmount       Decimal          @db.Decimal(20, 8) // Total sales amount
  platformFee       Decimal          @db.Decimal(20, 8) // Commission deducted
  networkFee        Decimal          @default(0) @db.Decimal(20, 8) // Gas/transaction fees
  netAmount         Decimal          @db.Decimal(20, 8) // Amount sent to merchant

  // Destination
  walletAddress     String

  // Transaction details
  txHash            String?          @unique

  // Status
  status            SettlementStatus @default(PENDING)

  // Period covered
  periodStart       DateTime
  periodEnd         DateTime

  // Related orders
  orderCount        Int              @default(0)

  // Workflow
  requestedAt       DateTime         @default(now())
  requestedBy       String?
  approvedAt        DateTime?
  approvedBy        String?
  processedAt       DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?

  // Retry handling
  retryCount        Int              @default(0)
  nextRetryAt       DateTime?

  // Links
  journalEntryId    String?          // Link to accounting entry

  // Items included in this settlement
  items             SettlementItem[]

  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([sellerId])
  @@index([status])
  @@index([stablecoinType])
  @@index([network])
  @@index([periodStart, periodEnd])
  @@index([txHash])
  @@map("settlements")
}

// Settlement Item - Orders/transactions included in a settlement
model SettlementItem {
  id              String      @id @default(uuid())
  settlementId    String
  settlement      Settlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  orderId         String
  orderNumber     String

  grossAmount     Decimal     @db.Decimal(20, 8)
  commission      Decimal     @db.Decimal(20, 8)
  netAmount       Decimal     @db.Decimal(20, 8)

  orderDate       DateTime

  createdAt       DateTime    @default(now())

  @@index([settlementId])
  @@index([orderId])
  @@map("settlement_items")
}

// Financial Period - For closing books and generating reports
model FinancialPeriod {
  id              String                @id @default(uuid())
  name            String                // "January 2024", "Q1 2024", etc.
  type            FinancialPeriodType   // MONTHLY, QUARTERLY, YEARLY

  startDate       DateTime
  endDate         DateTime

  // Status
  status          FinancialPeriodStatus @default(OPEN)
  closedAt        DateTime?
  closedBy        String?

  // Summary totals (cached for performance)
  totalRevenue    Decimal               @default(0) @db.Decimal(20, 8)
  totalCOGS       Decimal               @default(0) @db.Decimal(20, 8) // Cost of goods sold (merchant payouts)
  grossProfit     Decimal               @default(0) @db.Decimal(20, 8)
  totalExpenses   Decimal               @default(0) @db.Decimal(20, 8)
  netProfit       Decimal               @default(0) @db.Decimal(20, 8)

  reports         FinancialReport[]

  metadata        Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([type, startDate])
  @@index([status])
  @@index([startDate, endDate])
  @@map("financial_periods")
}

// Financial Report - Generated reports
model FinancialReport {
  id              String              @id @default(uuid())
  periodId        String?
  period          FinancialPeriod?    @relation(fields: [periodId], references: [id])

  type            FinancialReportType
  name            String

  // Date range (can be custom, not tied to period)
  startDate       DateTime
  endDate         DateTime

  // Report data (JSON for flexibility)
  data            Json

  // Generation info
  generatedAt     DateTime            @default(now())
  generatedBy     String?

  // Storage
  fileUrl         String?             // If exported to file

  metadata        Json?
  createdAt       DateTime            @default(now())

  @@index([periodId])
  @@index([type])
  @@index([startDate, endDate])
  @@map("financial_reports")
}

// Reconciliation Record - For tracking balance reconciliations
model ReconciliationRecord {
  id                    String                @id @default(uuid())
  date                  DateTime
  stablecoinType        StablecoinType
  network               NetworkType?

  // System balances (from our database)
  systemWalletBalance   Decimal               @db.Decimal(20, 8)
  systemMerchantPayable Decimal               @db.Decimal(20, 8)
  systemCustomerBalance Decimal               @db.Decimal(20, 8)

  // Blockchain balance (actual on-chain)
  blockchainBalance     Decimal               @db.Decimal(20, 8)

  // Calculated
  discrepancy           Decimal               @db.Decimal(20, 8)
  isReconciled          Boolean               @default(false)

  // Resolution
  resolvedAt            DateTime?
  resolvedBy            String?
  resolutionNotes       String?
  adjustmentEntryId     String?               // Journal entry for adjustment

  metadata              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([date])
  @@index([stablecoinType])
  @@index([network])
  @@index([isReconciled])
  @@map("reconciliation_records")
}

// Platform Revenue - Track all revenue sources
model PlatformRevenue {
  id              String          @id @default(uuid())
  date            DateTime

  // Source
  revenueType     RevenueType
  stablecoinType  StablecoinType

  // Reference
  referenceType   String?         // 'ORDER', 'API_FEE', 'WITHDRAWAL_FEE'
  referenceId     String?
  sellerId        String?

  // Amounts
  grossAmount     Decimal         @db.Decimal(20, 8) // Total order/transaction amount
  revenueAmount   Decimal         @db.Decimal(20, 8) // Platform's cut

  description     String?

  journalEntryId  String?

  metadata        Json?
  createdAt       DateTime        @default(now())

  @@index([date])
  @@index([revenueType])
  @@index([stablecoinType])
  @@index([sellerId])
  @@index([referenceType, referenceId])
  @@map("platform_revenue")
}

// Accounting Enums
enum LedgerAccountType {
  ASSET           // Company wallets, receivables
  LIABILITY       // Merchant payables, customer deposits
  EQUITY          // Owner's equity, retained earnings
  REVENUE         // Platform commissions, fees
  EXPENSE         // Gas fees, operational costs
  CONTRA_ASSET    // Accumulated depreciation (if any)
  CONTRA_LIABILITY
  CONTRA_REVENUE
  CONTRA_EXPENSE
}

enum LedgerEntryType {
  ORDER_RECEIVED      // Customer payment received
  MERCHANT_PAYABLE    // Amount owed to merchant
  COMMISSION_EARNED   // Platform commission
  SETTLEMENT_PAID     // Settlement sent to merchant
  REFUND_ISSUED       // Refund to customer
  GAS_FEE             // Blockchain gas fees
  WITHDRAWAL          // Company withdrawal
  DEPOSIT             // External deposit
  ADJUSTMENT          // Manual adjustment
  OPENING_BALANCE     // Initial balance
  CLOSING_ENTRY       // Period close entry
}

enum JournalEntryStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  REVERSED
}

enum SettlementStatus {
  PENDING           // Created, awaiting approval
  APPROVED          // Approved, ready to process
  PROCESSING        // Transaction submitted
  COMPLETED         // Successfully paid
  FAILED            // Transaction failed
  CANCELLED         // Cancelled before processing
  ON_HOLD           // Temporarily held
}

enum FinancialPeriodType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum FinancialPeriodStatus {
  OPEN
  CLOSING
  CLOSED
  ARCHIVED
}

enum FinancialReportType {
  BALANCE_SHEET
  INCOME_STATEMENT
  CASH_FLOW
  MERCHANT_SETTLEMENT_SUMMARY
  REVENUE_BY_MERCHANT
  REVENUE_BY_NETWORK
  RECONCILIATION
  TRIAL_BALANCE
  GENERAL_LEDGER
}

enum RevenueType {
  ORDER_COMMISSION      // Commission from orders
  API_COMMISSION        // Commission from external API orders
  WITHDRAWAL_FEE        // Withdrawal processing fees
  LISTING_FEE           // Product listing fees (if any)
  SUBSCRIPTION_FEE      // Merchant subscription fees (if any)
  OTHER                 // Miscellaneous revenue
}
